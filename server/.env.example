# ── Groq API ─────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for chat completions (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000

# Comma-separated list of allowed frontend origins (no trailing slashes).
# Include your local dev URL and your deployed Vercel URL.
FRONTEND_ORIGIN=http://localhost:5173,https://your-site.vercel.app
